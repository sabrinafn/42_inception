server {
	# HTTP only
	# listen 80 default_server;
	# listen [::]:80 default_server;

	# TLS (HTTPS)
	listen 443 ssl http2 default_server;
	listen [::]:443 ssl http2 default_server;
	ssl_certificate /etc/ssl/certs/sabrifer.42.fr.crt;
	ssl_certificate_key /etc/ssl/private/sabrifer.42.fr.key;

	server_name _;
	root /var/www/html;
	index index.php index.html index.htm;

	# WordPress front-controller pattern
	location / {
		try_files $uri $uri/ /index.php?$args;
	}

	# PHP handling via php-fpm in the "wp-php" container
	location ~ \.php$ {
		# Debian snippet sets fastcgi_params incl. SCRIPT_FILENAME
		include snippets/fastcgi-php.conf;
		fastcgi_pass wp-php:9000;
	}

	# Security: deny access to hidden files
	location ~ /\. {
		deny all;
	}
}
